mach create
machine LoadPlatformDescription @platforms/cpus/stm32f746.repl

machine LoadPlatformDescriptionFromString "phy: Network.EthernetPhysicalLayer @ ethernet 0"
machine LoadPlatformDescriptionFromString "bme280: I2C.BME280 @ i2c1 0x76"

sysbus LoadELF @build/zephyr/zephyr.elf

emulation CreateSwitch "switch"
emulation CreateTap "tap0" "tap"
connector Connect host.tap switch
connector Connect sysbus.ethernet switch

showAnalyzer sysbus.usart3
start